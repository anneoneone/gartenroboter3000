[Unit]
Description=Gartenroboter3000 Garden Automation System
Documentation=https://github.com/anneoneone/gartenroboter3000
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%USERNAME%
Group=%USERNAME%
WorkingDirectory=%USERHOME%/gartenroboter3000

# Environment
Environment="PATH=%USERHOME%/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%USERHOME%/gartenroboter3000/.env

# Start command
ExecStart=%USERHOME%/.local/bin/uv run gartenroboter

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gartenroboter

# ===== Raspberry Pi 4 Resource Configuration =====
# Cap memory for stability (256MB limit for tight resource conditions)
MemoryMax=256M
MemoryAccounting=yes

# Limit CPU to prevent fork bombs (2 cores, use ~1.5)
CPUQuota=75%
CPUAccounting=yes

# Prevent OOM from crashing the whole system
OOMPolicy=kill

# ===== Security hardening =====
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%USERHOME%/gartenroboter3000/data %USERHOME%/gartenroboter3000/logs
PrivateTmp=true

# GPIO access
SupplementaryGroups=gpio spi i2c

[Install]
WantedBy=multi-user.target
