# Gartenroboter3000 Configuration
# Raspberry Pi 4 Model B Optimized
#
# ⚠️ IMPORTANT:
#   - This file is sourced by systemd, so use shell-safe variable names
#   - All values should be strings or numbers (no complex expansions)
#   - Never commit your .env with real tokens to git!
#   - Use 'chmod 600 .env' for security

# ============================================================
# TELEGRAM CONFIGURATION (Required)
# ============================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=8699595089:AAF5P8Fb1fTC75fzRDcTcjXmJeHqnt_b27M

# Your Telegram chat ID (use @userinfobot to find it)
# Comma-separated list for multiple users
TELEGRAM_ALLOWED_CHAT_IDS=622928025

# Admin chat IDs (can manage whitelist)
TELEGRAM_ADMIN_CHAT_IDS=622928025

# ============================================================
# WEATHER API CONFIGURATION (Required)
# ============================================================
# Get your API key from https://openweathermap.org/api
OPENWEATHER_API_KEY=cc5c6c3c8bad91f0528e134d614e43c2

# Your location coordinates (for sunset calculation)
LOCATION_LATITUDE=52.5200
LOCATION_LONGITUDE=13.4050
LOCATION_TIMEZONE=Europe/Berlin

# ============================================================
# SENSOR THRESHOLDS (Optional - RPi 4 optimized defaults)
# ============================================================
# Soil moisture threshold (0-100%, below = dry)
# RPi 4: Use standard 30% (aggressive monitoring, plenty of performance)
SENSOR_SOIL_THRESHOLD_DRY=30

# Water level minimum (0-100%, below = warning)
# RPi 4: Keep at default since hardware is responsive
SENSOR_WATER_LEVEL_MIN=15

# Pi temperature warning threshold (Celsius)
# RPi 4: Can use lower threshold, better cooling and monitoring
SENSOR_PI_TEMP_WARNING=75

# ============================================================
# PUMP CONFIGURATION (Optional - defaults shown)
# ============================================================
# Maximum pump runtime per cycle (seconds, 10-300)
PUMP_MAX_RUNTIME=180

# Cooldown between pump cycles (seconds, 60-600)
PUMP_COOLDOWN=300

# ============================================================
# GPIO PIN CONFIGURATION (Optional - defaults shown)
# ============================================================
# MCP3008 ADC chip select pin
GPIO_ADC_CS_PIN=8

# Soil moisture sensor channels on MCP3008 (0-7)
GPIO_SOIL_SENSOR_CHANNELS=0,1,2,3

# Water level sensor channel on MCP3008
GPIO_WATER_LEVEL_CHANNEL=4

# Pump relay control pin
GPIO_PUMP_RELAY_PIN=17

# Second pump relay GPIO pin (optional, for dual-pump setup)
# Set to 0 or comment out if not using a second pump
# Recommended pin: GPIO 27 (or any unused GPIO)
GPIO_PUMP_RELAY_PIN_2=27

# HC-SR04 ultrasonic sensor pins (alternative to analog)
GPIO_ULTRASONIC_TRIGGER_PIN=23
GPIO_ULTRASONIC_ECHO_PIN=24

# ============================================================
# DATABASE CONFIGURATION (RPi 4 optimized)
# ============================================================
# Database file path
DATABASE_PATH=data/gartenroboter.db

# Data retention period (days)
# RPi 4: Use 180 days with ample storage (~32GB microSD available)
# Extended history allows for better trend analysis
DATABASE_RETENTION_DAYS=180

# ============================================================
# SCHEDULER CONFIGURATION (RPi 4 optimized)
# ============================================================
# Sensor polling interval (seconds)
# RPi 4: Use 15s for aggressive real-time monitoring
# Quad-core 1.5GHz CPU handles this with ease
SCHEDULER_SENSOR_INTERVAL=15

# Watering check interval (seconds)
# RPi 4: Use standard 300s (5 minutes) for responsive control
# Fast processing and no CPU bottlenecks
SCHEDULER_WATERING_INTERVAL=300

# ============================================================
# DEVELOPMENT MODE
# ============================================================
# Set to true to use mock GPIO/sensors (for development)
MOCK_MODE=false

# Log level: DEBUG, INFO, WARNING, ERROR
# RPi 4: Can safely use DEBUG for detailed monitoring
LOG_LEVEL=INFO
